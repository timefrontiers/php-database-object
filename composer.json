{
  "name": "timefrontiers/php-database-object",
  "description": "SQL Database Object trait for Active Record pattern",
  "type": "library",
  "license": "MIT",
  "keywords": ["php", "database", "orm", "active-record", "sql"],
  "authors": [
    {
      "name": "TimeFrontiers",
      "email": "dev@timefrontiers.com",
      "homepage": "https://timefrontiers.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "timefrontiers/php-core": "^1.0",
    "timefrontiers/php-has-errors": "^1.0",
    "timefrontiers/php-sql-database": "^1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "suggest": {
    "timefrontiers/php-instance-error": "For extracting and filtering errors by user rank"
  },
  "autoload": {
    "psr-4": {
      "TimeFrontiers\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TimeFrontiers\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "test-integration": "@php vendor/bin/phpunit --testsuite MySQLi,PDO",
    "test-mysqli": "@php vendor/bin/phpunit --testsuite MySQLi",
    "test-pdo": "@php vendor/bin/phpunit --testsuite PDO",
    "test-transaction": "@php vendor/bin/phpunit --group transaction",
    "test-unit": "@php vendor/bin/phpunit --testsuite Unit"
  }
}
